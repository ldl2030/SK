<Window x:Class="TestPlatform.LEDConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LED分析仪配置" 
        Height="720" Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- 颜色定义 -->
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6F9"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4A6FA5"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#6B8FC7"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>

        <!-- 下限文本框样式（浅红背景） -->
        <Style x:Key="LowerTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFCDD2"/>
            <Setter Property="Background" Value="#FFF5F5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="下限值"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryLight}"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 上限文本框样式（浅绿背景） -->
        <Style x:Key="UpperTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C8E6C9"/>
            <Setter Property="Background" Value="#F1F8E9"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="上限值"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryLight}"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 参数标签样式 -->
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 卡片淡入动画 -->
        <Storyboard x:Key="CardFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                             From="0" To="1" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="30" To="0" Duration="0:0:0.3"/>
        </Storyboard>

        <!-- 窗口滑入动画 -->
        <Storyboard x:Key="WindowSlideIn">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="50" To="0" Duration="0:0:0.3"/>
        </Storyboard>

        <!-- 按钮样式 -->
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.02" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.02" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform/>
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource WindowSlideIn}"/>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏区域 -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" Padding="20,12" CornerRadius="0,0,12,12">
            <StackPanel>
                <TextBlock Text="LED 分析仪 · 8通道参数配置" 
                           FontSize="18" FontWeight="SemiBold" 
                           Foreground="White" Margin="0,0,0,4"/>
                <TextBlock Text="为每个通道独立设置检测上下限（留空则不检测该项）" 
                           FontSize="12" Foreground="#D0E2FF"/>
            </StackPanel>
        </Border>

        <!-- 通道列表区域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                      Margin="16,20,16,10">
            <ItemsControl x:Name="ChannelsControl" ItemsSource="{Binding Channels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBackgroundBrush}" 
                                CornerRadius="12" 
                                Margin="0,0,0,12" 
                                Padding="12"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1"
                                RenderTransformOrigin="0.5,0.5"
                                Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform X="30"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                                             From="0" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="30" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                            <StackPanel>
                                <!-- 通道标题 -->
                                <TextBlock Text="{Binding ChannelIndex, StringFormat='通道 {0}'}" 
                                           FontSize="15" FontWeight="Bold" 
                                           Foreground="{StaticResource PrimaryColor}"
                                           Margin="0,0,0,12"/>

                                <!-- 7个参数网格布局 (2行7列) 改为更清晰的上下限并排显示 -->
                                <UniformGrid Columns="7" Rows="2" HorizontalAlignment="Stretch">
                                    <!-- 频率 -->
                                    <Border Margin="4,0" Padding="0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource ParamLabel}" Text="频率 (Hz)" Foreground="#FF6B6B"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <TextBox Text="{Binding FreqLower, StringFormat='0.000'}" Style="{StaticResource LowerTextBox}" Width="60"/>
                                                <TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" Foreground="#64748B"/>
                                                <TextBox Text="{Binding FreqUpper, StringFormat='0.000'}" Style="{StaticResource UpperTextBox}" Width="60"/>
                                            </StackPanel>
                                            <TextBlock Text="下限     上限" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- 计数值 -->
                                    <Border Margin="4,0" Padding="0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource ParamLabel}" Text="计数值"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <TextBox Text="{Binding CountLower}" Style="{StaticResource LowerTextBox}" Width="60"/>
                                                <TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" Foreground="#64748B"/>
                                                <TextBox Text="{Binding CountUpper}" Style="{StaticResource UpperTextBox}" Width="60"/>
                                            </StackPanel>
                                            <TextBlock Text="下限     上限" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- 红分量 -->
                                    <Border Margin="4,0" Padding="0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource ParamLabel}" Text="R (0-255)" Foreground="#EF4444"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <TextBox Text="{Binding RedLower}" Style="{StaticResource LowerTextBox}" Width="60"/>
                                                <TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" Foreground="#64748B"/>
                                                <TextBox Text="{Binding RedUpper}" Style="{StaticResource UpperTextBox}" Width="60"/>
                                            </StackPanel>
                                            <TextBlock Text="下限     上限" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- 绿分量 -->
                                    <Border Margin="4,0" Padding="0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource ParamLabel}" Text="G (0-255)" Foreground="#10B981"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <TextBox Text="{Binding GreenLower}" Style="{StaticResource LowerTextBox}" Width="60"/>
                                                <TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" Foreground="#64748B"/>
                                                <TextBox Text="{Binding GreenUpper}" Style="{StaticResource UpperTextBox}" Width="60"/>
                                            </StackPanel>
                                            <TextBlock Text="下限     上限" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- 蓝分量 -->
                                    <Border Margin="4,0" Padding="0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource ParamLabel}" Text="B (0-255)" Foreground="#3B82F6"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <TextBox Text="{Binding BlueLower}" Style="{StaticResource LowerTextBox}" Width="60"/>
                                                <TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" Foreground="#64748B"/>
                                                <TextBox Text="{Binding BlueUpper}" Style="{StaticResource UpperTextBox}" Width="60"/>
                                            </StackPanel>
                                            <TextBlock Text="下限     上限" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- 色调 -->
                                    <Border Margin="4,0" Padding="0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource ParamLabel}" Text="色调 (°)"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <TextBox Text="{Binding HueLower, StringFormat='0.00'}" Style="{StaticResource LowerTextBox}" Width="60"/>
                                                <TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" Foreground="#64748B"/>
                                                <TextBox Text="{Binding HueUpper, StringFormat='0.00'}" Style="{StaticResource UpperTextBox}" Width="60"/>
                                            </StackPanel>
                                            <TextBlock Text="下限     上限" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- 亮度 -->
                                    <Border Margin="4,0" Padding="0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource ParamLabel}" Text="亮度"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <TextBox Text="{Binding BrightnessLower}" Style="{StaticResource LowerTextBox}" Width="60"/>
                                                <TextBlock Text="~" Margin="4,0" VerticalAlignment="Center" Foreground="#64748B"/>
                                                <TextBox Text="{Binding BrightnessUpper}" Style="{StaticResource UpperTextBox}" Width="60"/>
                                            </StackPanel>
                                            <TextBlock Text="下限     上限" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 底部操作栏 -->
        <Border Grid.Row="2" Background="White" CornerRadius="12,12,0,0" 
                Padding="16,12" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Background="#94A3B8" Click="Cancel_Click" Width="90" Margin="0,0,12,0"/>
                <Button Content="保存设置" Click="Save_Click" Width="110"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>