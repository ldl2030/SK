<Window x:Class="TestPlatform.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置" Height="760" Width="1100"
        MinHeight="620" MinWidth="840"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        Background="#EEF3F9"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4A6FA5"/>
        <SolidColorBrush x:Key="PrimaryDark" Color="#335782"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#6B8FC7"/>
        <SolidColorBrush x:Key="PrimarySoft" Color="#EAF1FB"/>
        <SolidColorBrush x:Key="PageBrush" Color="#EEF3F9"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceSoft" Color="#F8FAFD"/>
        <SolidColorBrush x:Key="BorderColor" Color="#DDE6F0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2EAD68"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>

        <DropShadowEffect x:Key="SoftShadow" BlurRadius="18" ShadowDepth="4" Opacity="0.10" Color="#22324A"/>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="PageSubTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryLight}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryLight}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="SwitchTrack" Width="42" Height="22" Background="#CBD5E1" CornerRadius="11" VerticalAlignment="Center">
                                <Ellipse x:Name="SwitchThumb" Width="18" Height="18" Fill="White" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,24,10"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="174"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="#E7EEF7"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F8FBFF"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="White" CornerRadius="18" Effect="{StaticResource SoftShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F8FAFD" CornerRadius="18,18,0,0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="24,20,24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" Background="{StaticResource PrimarySoft}" CornerRadius="14" Margin="0,0,14,0">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" FontSize="19"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="系统设置" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="集中配置 MES、上传、测试行为、界面显示与高级参数。" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="tabControl" Grid.Row="1" Margin="24,18,24,0">
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77A;" Margin="0,0,8,0"/>
                            <TextBlock Text="基础"/>
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer x:Name="BaseScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
                        <StackPanel Margin="0,0,14,18">
                            <Border Background="{StaticResource PrimarySoft}" CornerRadius="14" Padding="18" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="12" Background="White" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="基础连接配置" Style="{StaticResource PageTitle}"/>
                                        <TextBlock Text="..." Style="{StaticResource PageSubTitle}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <Border Width="38" Height="38" Background="{StaticResource PrimarySoft}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE946;"/>
                                        </Border>
                                        <TextBlock Text="MES 基础设置" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="配置工单、工站以及 MES 进站/过站开关。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox x:Name="chkMESEnable" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Content="启用 MES"/>
                                        <Label Grid.Row="1" Grid.Column="0" Content="工单号" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="txtWorkOrder" Grid.Row="1" Grid.Column="1"/>
                                        <Label Grid.Row="1" Grid.Column="3" Content="工站号" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="txtWorkStation" Grid.Row="1" Grid.Column="4"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <Border Width="38" Height="38" Background="{StaticResource PrimarySoft}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE896;"/>
                                        </Border>
                                        <TextBlock Text="FTP 基础设置" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="用于将测试报告上传到 FTP 服务器。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox x:Name="chkFTPEnable" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Content="启用 FTP"/>
                                        <Label Grid.Row="1" Grid.Column="0" Content="服务器" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="txtFTPServer" Grid.Row="1" Grid.Column="1"/>
                                        <Label Grid.Row="1" Grid.Column="3" Content="端口" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="txtFTPPort" Grid.Row="1" Grid.Column="4" Text="21"/>
                                        <Label Grid.Row="2" Grid.Column="0" Content="用户名" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="txtFTPUser" Grid.Row="2" Grid.Column="1"/>
                                        <Label Grid.Row="2" Grid.Column="3" Content="密码" Style="{StaticResource FormLabel}"/>
                                        <PasswordBox x:Name="txtFTPPassword" Grid.Row="2" Grid.Column="4"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <Border Width="38" Height="38" Background="{StaticResource PrimarySoft}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE838;"/>
                                        </Border>
                                        <TextBlock Text="SMB 共享设置" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="适合上传到内网共享目录。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox x:Name="chkSMBEnable" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Content="启用 SMB 上传"/>
                                        <Label Grid.Row="1" Grid.Column="0" Content="共享路径" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="txtSMBServerPath" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="\192.168.30.7\Testresult"/>
                                        <Label Grid.Row="2" Grid.Column="0" Content="用户名" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="txtSMBUsername" Grid.Row="2" Grid.Column="1"/>
                                        <Label Grid.Row="2" Grid.Column="3" Content="密码" Style="{StaticResource FormLabel}"/>
                                        <PasswordBox x:Name="txtSMBPassword" Grid.Row="2" Grid.Column="4"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Text="路径格式示例：\192.168.30.7\Testresult" Style="{StaticResource CardHint}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <Border Width="38" Height="38" Background="{StaticResource PrimarySoft}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE749;"/>
                                        </Border>
                                        <TextBlock Text="在线打印" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="测试完成后自动触发标签或报告打印。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="chkOnlinePrint" Grid.Column="1" Content="启用在线打印" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,8,0"/>
                            <TextBlock Text="测试行为"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer x:Name="BehaviorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
                        <StackPanel Margin="0,0,14,18">
                            <Border Background="{StaticResource PrimarySoft}" CornerRadius="14" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="测试执行行为" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="..." Style="{StaticResource PageSubTitle}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <TextBlock Text="测试完成后" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="配置测试结束后的自动动作。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <CheckBox x:Name="chkAutoClearSN" Content="自动清空 SN 输入框" Margin="0,0,28,12"/>
                                        <CheckBox x:Name="chkAutoSaveResult" Content="自动保存测试结果" Margin="0,0,28,12"/>
                                        <CheckBox x:Name="chkPlayBeep" Content="播放提示音"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <Border Width="38" Height="38" Background="{StaticResource PrimarySoft}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,10">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;"/>
                                        </Border>
                                        <TextBlock Text="报告保存方式" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="选择测试报告的本地保存格式，上传到 FTP / SMB 时仍复用当前平台的统一上传逻辑。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{StaticResource SurfaceSoft}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="360"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Label Grid.Row="0" Grid.Column="0" Content="保存格式" Style="{StaticResource FormLabel}" Margin="0,0,12,0"/>
                                            <ComboBox x:Name="cmbReportSaveMode" Grid.Row="0" Grid.Column="1" Height="36" Margin="0" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="累加 CSV 文件（当前模式）"/>
                                                <ComboBoxItem Content="每个 SN 保存单个 Excel 文件"/>
                                            </ComboBox>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="CSV适合长期累加统计，Excel适合单台产品追溯。" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                                       Text="Excel 模式下文件名按 SN 保存；如果同名文件已存在，会自动追加 年月日时分，避免覆盖。"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <TextBlock Text="并行测试配置" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="设置同时开启的测试通道数量。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="测试窗口数" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="txtParallelCount" Grid.Column="1" Text="3" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="开启同时测试数量 1~8" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,12"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <TextBlock Text="SN 输入规则" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="控制条码前缀、长度以及输入格式。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox x:Name="chkEnforcePrefix" Grid.Row="0" Grid.Column="0" Content="强制前缀"/>
                                        <CheckBox x:Name="chkEnforceLength" Grid.Row="0" Grid.Column="2" Content="限制长度"/>
                                        <Grid Grid.Row="1" Grid.Column="0" IsEnabled="{Binding IsChecked, ElementName=chkEnforcePrefix}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="前缀" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="txtSNPrefix" Grid.Column="1"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="2" IsEnabled="{Binding IsChecked, ElementName=chkEnforceLength}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="长度" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="txtSNLength" Grid.Column="1"/>
                                        </Grid>
                                        <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                            <CheckBox x:Name="chkAutoUpper" Content="自动转换为大写" Margin="0,0,28,12"/>
                                            <CheckBox x:Name="chkAllowEmptySN" Content="允许条码为空"/>
                                        </WrapPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <TextBlock Text="测试失败处理" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="控制失败后的停止、提示和重测策略。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox x:Name="chkStopOnFail" Grid.Row="0" Grid.Column="0" Content="失败时停止整个测试" IsChecked="True"/>
                                        <CheckBox x:Name="chkPromptOnFail" Grid.Row="0" Grid.Column="2" Content="失败时弹窗提示" IsChecked="True"/>
                                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="失败重测" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="txtFailRetryCount" Grid.Column="1" Text="0" TextAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="0 表示不重测，2 表示失败后最多重测 2 次" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,12"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE115;" Margin="0,0,8,0"/>
                            <TextBlock Text="外观与行为"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer x:Name="VisualScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
                        <StackPanel Margin="0,0,14,18">
                            <Border Background="{StaticResource PrimarySoft}" CornerRadius="14" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="界面显示与操作习惯" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="主题、工具栏、窗口行为和操作员保护均改为整行卡片。" Style="{StaticResource PageSubTitle}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <TextBlock Text="主题颜色" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="设置浅色/深色模式和主色调。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <RadioButton x:Name="rbLightTheme" Content="浅色模式" GroupName="Theme"/>
                                            <RadioButton x:Name="rbDarkTheme" Content="深色模式" GroupName="Theme"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="主色调" Style="{StaticResource FormLabel}"/>
                                            <ComboBox x:Name="cmbAccentColor" Grid.Column="1">
                                                <ComboBoxItem Content="绿色" Tag="#4CAF50"/>
                                                <ComboBoxItem Content="蓝色" Tag="#2196F3"/>
                                                <ComboBoxItem Content="橙色" Tag="#FF9800"/>
                                                <ComboBoxItem Content="红色" Tag="#F44336"/>
                                                <ComboBoxItem Content="紫色" Tag="#9C27B0"/>
                                                <ComboBoxItem Content="青色" Tag="#00BCD4"/>
                                                <ComboBoxItem Content="粉色" Tag="#E91E63"/>
                                                <ComboBoxItem Content="棕色" Tag="#795548"/>
                                                <ComboBoxItem Content="深蓝" Tag="#3F51B5"/>
                                                <ComboBoxItem Content="浅绿" Tag="#8BC34A"/>
                                            </ComboBox>
                                            <Button x:Name="btnResetColor" Grid.Column="2" Content="恢复默认" Margin="12,0,0,12" Click="BtnResetColor_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <TextBlock Text="工具栏图标样式" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="选择主界面工具栏显示方式。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Content="图标样式" Style="{StaticResource FormLabel}"/>
                                        <ComboBox x:Name="cmbIconStyle" Grid.Column="1">
                                            <ComboBoxItem Content="字体图标" Tag="FontIcon"/>
                                            <ComboBoxItem Content="图片图标" Tag="ImageIcon"/>
                                            <ComboBoxItem Content="仅文字" Tag="TextOnly"/>
                                        </ComboBox>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <TextBlock Text="窗口行为" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="控制窗口记忆和开机启动。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <CheckBox x:Name="chkRememberWindowPos" Content="记忆窗口位置和大小" Margin="0,0,28,12"/>
                                        <CheckBox x:Name="chkAutoStart" Content="开机自启"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <TextBlock Text="操作员模式" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="启用后修改设置需要密码，并可强制打开关键功能。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <CheckBox x:Name="chkOperatorMode" Grid.Row="0" Content="启用操作员模式"/>
                                        <Grid Grid.Row="1" IsEnabled="{Binding IsChecked, ElementName=chkOperatorMode}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Content="密码" Style="{StaticResource FormLabel}"/>
                                            <PasswordBox x:Name="txtOperatorPassword" Grid.Column="1"/>
                                        </Grid>
                                        <TextBlock Grid.Row="2" Text="默认密码：123456" Style="{StaticResource CardHint}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81E;" Margin="0,0,8,0"/>
                            <TextBlock Text="高级"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer x:Name="AdvancedScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0">
                        <StackPanel Margin="0,0,14,18">
                            <Border Background="{StaticResource PrimarySoft}" CornerRadius="14" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="高级参数" Style="{StaticResource PageTitle}"/>
                                    <TextBlock Text="设置 MES 服务地址，并支持配置导入导出。" Style="{StaticResource PageSubTitle}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <TextBlock Text="MES 服务地址" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="配置 MES 系统请求地址。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Label Grid.Row="0" Grid.Column="0" Content="IP地址" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="txtMESIP" Grid.Row="0" Grid.Column="1"/>
                                        <Label Grid.Row="0" Grid.Column="2" Content="端口" Style="{StaticResource FormLabel}" Margin="18,0,12,12"/>
                                        <TextBox x:Name="txtMESPort" Grid.Row="0" Grid.Column="3" Text="8080"/>
                                        <Label Grid.Row="1" Grid.Column="0" Content="API路径" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="txtMESPath" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="/api/"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,22,0">
                                        <TextBlock Text="配置导入 / 导出" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="用于备份或恢复系统设置。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button x:Name="btnExport" Content="导出配置" Width="120" Click="BtnExport_Click"/>
                                            <Button x:Name="btnImport" Content="导入配置" Width="120" Margin="12,0,0,0" Click="BtnImport_Click"/>
                                        </StackPanel>
                                        <TextBlock Text="导入配置将覆盖当前所有设置，建议导入前先导出备份。" Style="{StaticResource CardHint}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="#F8FAFD" CornerRadius="0,0,18,18" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,16">
                <Grid>
                    <TextBlock Text="修改后点击“确定”保存，点击“取消”放弃本次更改。" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnOK" Content="确定" Width="104" Click="BtnOK_Click"/>
                        <Button x:Name="btnCancel" Content="取消" Width="104" Margin="12,0,0,0" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
