<Window x:Class="TestPlatform.FixtureDownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="治具下压确认" Height="430" Width="580" MinHeight="380" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True">
    <Window.Resources>
        <!-- 旋转动画 -->
        <Storyboard x:Key="RotateAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:2" RepeatBehavior="Forever"/>
        </Storyboard>
        <!-- 脉冲动画 -->
        <Storyboard x:Key="PulseAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0.3" To="1" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.8" To="1.2" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.8" To="1.2" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
        <Style TargetType="Button" x:Key="RoundButton">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#0B5CAD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="20" 
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#004C8C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="20" BorderBrush="#E0E0E0" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.25"/>
        </Border.Effect>
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 动态加载图标（旋转的齿轮） -->
            <Grid Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Ellipse Width="60" Height="60" Stroke="#4CAF50" StrokeThickness="3" 
                         Opacity="0.6" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource RotateAnimation}"/>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Ellipse Width="40" Height="40" Fill="#4CAF50" Opacity="0.2"/>
                <TextBlock Text="⚙" FontFamily="Segoe MDL2 Assets" FontSize="30" 
                           Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </TextBlock.RenderTransform>
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource RotateAnimation}"/>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Grid>

            <!-- 动态标题区域 -->
            <TextBlock Grid.Row="1" x:Name="tbTitle" Text="等待治具下压" FontSize="20" FontWeight="Bold"
                       Foreground="#172033"
                       HorizontalAlignment="Center" Margin="0,0,0,15"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </TextBlock.RenderTransform>
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource PulseAnimation}"/>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

            <!-- 提示信息（中英文） -->
            <TextBlock Grid.Row="2" x:Name="tbMessage" Text="SN扫描成功，请下压气缸自动开始测试！" 
                       FontSize="16" FontWeight="Bold" Foreground="#172033"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Grid.Row="3" x:Name="tbMessageEn" Text="SN scanned successfully, please press down the fixture to start the test!" 
                       FontSize="14" FontWeight="SemiBold" Foreground="#40516B"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- 动态进度条（倒计时） -->
            <ProgressBar x:Name="progressBar" Grid.Row="4" Height="8" Minimum="0" Maximum="100" 
                         Value="100" Foreground="#4CAF50" Background="#E8E8E8" Margin="0,0,0,15"/>

            <!-- 动态状态文本 -->
            <TextBlock x:Name="tbStatus" Grid.Row="5" Text="等待中..." FontSize="14" FontWeight="Bold"
                       Foreground="#713800" HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="btnCancel" Content="取消 Cancel" Style="{StaticResource RoundButton}" 
                        Background="#B42318" Foreground="White" Click="BtnCancel_Click" MinWidth="130"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
