<Window x:Class="TestPlatform.WaitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="请稍候(Please wait)" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="450" MaxWidth="720"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <!-- 旋转动画 -->
        <Storyboard x:Key="RotateAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
        </Storyboard>
        <!-- 脉冲动画 -->
        <Storyboard x:Key="PulseAnimation">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                             From="0.6" To="1" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>
    <Border Background="White" CornerRadius="16" BorderBrush="#E0E0E0" BorderThickness="1" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15"/>
        </Border.Effect>
        <Grid Margin="30,25,30,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 动态图标（旋转的圆圈） -->
            <Grid Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Ellipse Width="50" Height="50" Stroke="#4CAF50" StrokeThickness="3" 
                         Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="0"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource RotateAnimation}"/>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="⏳" FontSize="28" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- 提示标题 -->
            <TextBlock x:Name="tbTitle" Grid.Row="1" Text="请稍候...(Please wait moment...)" FontSize="18" FontWeight="Bold"
                       TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#172033">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource PulseAnimation}"/>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>

            <!-- 剩余时间文本 -->
            <TextBlock x:Name="tbCountdown" Grid.Row="2" Text="剩余 0.0 秒" FontSize="16" FontWeight="SemiBold" Foreground="#40516B"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- 进度条 -->
            <ProgressBar x:Name="progressBar" Grid.Row="3" Height="8" Minimum="0" Maximum="100" 
                         Value="100" Foreground="#4CAF50" Background="#E8E8E8" Margin="0,5,0,20"/>

            <!-- 取消按钮 -->
            <Button x:Name="btnCancel" Grid.Row="4" Content="取消 / Cancel" MinWidth="130" Height="42" HorizontalAlignment="Center"
                    Cursor="Hand" Background="#B42318" Foreground="White" BorderBrush="#8F1C13" Margin="0,30,0,0"
                    Click="BtnCancel_Click" FontSize="16" FontWeight="Bold"/>
        </Grid>
    </Border>
</Window>
