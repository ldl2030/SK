  <appSettings>
    <!-- SK441Device (skmps/bcm125/250) 必须配置的补充串口 -->
    <add key="AnsPort" value="COM1" />
    <add key="HengHui1Port" value="COM2" />
    <add key="HengHui2Port" value="COM3" />
    <add key="LoadPort" value="COM4" />
    <add key="DaqPort" value="COM5" />
    <add key="TargetBoardPort" value="COM6" />
    <add key="TtlPort" value="COM7" />
    <add key="SKSkipComInit" value="true" />
    <add key="SKAnsCurrentLimit" value="1.0" />
    <add key="SKDaqVoltageChannel" value="@101" />
    <add key="SKDaqVoltageRange" value="10.0" />
    <add key="SKRelayAddress" value="1" />
    <add key="SKRelayBaudRate" value="38400" />
    <add key="SKRelayComPort" value="" />
    <add key="SKRelayCount" value="64" />
    <add key="SKPlacementRelayA" value="@218" />
    <add key="SKPlacementRelayB" value="@219" />
    <add key="SKFixtureRelayAddress" value="1" />
    <add key="SKFixtureRelayBaudRate" value="38400" />
    <add key="SKFixtureRelayComPort" value="" />
    <add key="SKFixtureReleaseRelays" value="1,2" />
    <add key="SKBypassFixtureDownCheck" value="false" />
    <add key="SKFixtureNoticeMinimumSeconds" value="3" />
  </appSettings>
