  </runtime>
  <appSettings>
    <!-- SK441Device (skmps/bcm125/250) 必须配置的补充串口 -->
    <add key="AnsPort" value="COM23" />
    <add key="HengHui1Port" value="COM6" />
    <add key="HengHui2Port" value="COM22" />
    <add key="LoadPort" value="COM18" />
    <add key="DaqPort" value="COM16" />
    <!-- MBD USB-B由自动识别发送单字节0D确认，不固定COM号。 -->
    <add key="TargetBoardPort" value="" />
    <!-- TTL烧录口必须是独立串口；禁止与COM12的三站RS485总线复用。 -->
    <add key="TtlPort" value="" />
    <add key="SKBCM250FirmwarePath" value="" />
    <!-- BCM250使用内置STM32 UART Bootloader烧录器；无需CubeProgrammer。 -->
    <add key="SKRequireTtl" value="true" />
    <add key="SKTargetBoardBaudRate" value="9600" />
    <add key="SKMPS250TargetBoardBaudRate" value="115200" />
    <add key="SKMbdOpenSettleMs" value="500" />
    <add key="SKMbdProbeTimeoutMs" value="2000" />
    <!-- USB-B may disappear/re-enumerate after programming or DUT power cycling. -->
    <add key="SKMbdRecoveryTimeoutMs" value="15000" />
    <add key="SKMbdRecoveryRetryMs" value="750" />
    <add key="SKMbdRecoveryCommandTimeoutMs" value="2000" />
    <!-- 9600 baud MBD命令正常应在数百毫秒内回复；仅启动识别保留2秒探测超时。 -->
    <add key="SKMbdCommandTimeoutMs" value="700" />
    <add key="SKAutoDiscoverPorts" value="true" />
    <add key="HengHuiPowerAUsbSerial" value="FTBBD8D9A" />
    <add key="HengHuiPowerBUsbSerial" value="FTB6D146A" />
    <!-- MPS-250 power forensic telemetry; short reads avoid delaying emergency shutdown. -->
    <add key="SKMPS250PowerTelemetryEnabled" value="true" />
    <add key="SKMPS250PowerTelemetryIntervalMs" value="1000" />
    <add key="SKMPS250PowerTelemetryReadTimeoutMs" value="250" />
    <!-- B01/D01 wait for the 275 V source to reach stable measured voltage before DAQ reads. -->
    <add key="SKMPS250VbusMinimumSettleMs" value="500" />
    <add key="SKMPS250VbusStableTimeoutMs" value="5000" />
    <add key="SKElectronicLoadBaudRate" value="38400" />
    <add key="SKElectronicLoadPowerOnDelayMs" value="3000" />
    <add key="SKElectronicLoadReadbackDelayMs" value="300" />
    <add key="SKElectronicLoadCvReadbackToleranceV" value="15" />
    <add key="SKAnsAddress" value="1" />
    <!-- 8602电源A/B各使用独立COM口及SCPI协议，不使用Modbus从站地址。 -->
    <!-- DI1-DI10原始电平按位归一化：DI4/P2直通，其余通道反相，掩码0x03F7。 -->
    <add key="SKDigitalInputInvertMask" value="1015" />
    <!-- DI8逻辑1=急停，0=正常。 -->
    <add key="SKEmergencyStopActiveHigh" value="true" />
    <add key="SKDigitalInputPort" value="COM12" />
    <add key="SKDigitalInputAddress" value="2" />
    <add key="SKDigitalInputBaudRate" value="38400" />
    <!-- SK 仪器模式单点开关：Simulation=离线模拟，Hardware=连接真实仪器。
         也可临时设置环境变量 TESTPLATFORM_SK_MODE 覆盖此值。 -->
    <add key="SKExecutionMode" value="Hardware" />
    <add key="SKBCM250FixtureOnly" value="false" />
    <add key="SKAnsCurrentLimit" value="1.0" />
    <add key="SKDaqVoltageChannel" value="@101" />
    <add key="SKDaqVoltageRange" value="10.0" />
    <add key="SKRelayAddress" value="3" />
    <add key="SKRelayBaudRate" value="38400" />
    <add key="SKRelayComPort" value="COM12" />
    <add key="SKRelayCount" value="16" />
    <add key="SKPlacementRelayA" value="@318" />
    <add key="SKPlacementRelayB" value="@319" />
    <add key="SKFixtureRelayAddress" value="1" />
    <add key="SKFixtureRelayBaudRate" value="38400" />
    <add key="SKFixtureRelayComPort" value="COM12" />
    <!-- 工装站1下压映射；代码会按板型强制校验，防止与功率继电器站3混淆。 -->
    <add key="SKBCM125FixtureRelays" value="1,2" />
    <add key="SKBCM250FixtureRelays" value="1" />
    <add key="SKMPS125FixtureRelays" value="1" />
    <add key="SKMPS250FixtureRelays" value="1" />
    <add key="SKSafetyPollMs" value="100" />
    <add key="SKBypassFixtureDownCheck" value="false" />
    <add key="SKFixtureNoticeMinimumSeconds" value="3" />
    <add key="SKFixtureDownTimeoutMs" value="30000" />
    <!-- 高压继电器切换和治具释放前的掉电确认参数。 -->
    <add key="SKSafeOpenVoltageThreshold" value="20.0" />
    <add key="SKSafeOpenCurrentThreshold" value="0.05" />
    <add key="SKSafeDischargeTimeoutMs" value="30000" />
    <add key="SKSafeDischargePollMs" value="200" />
  </appSettings>
</configuration>
