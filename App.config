  </runtime>
  <appSettings>
    <!-- SK工位固定设备按USB身份自动定位；下列COM号留空以便整套工位迁移到其他电脑。 -->
    <add key="AnsPort" value="" />
    <add key="AnsPowerUsbSerial" value="FTBBD8V0A" />
    <!-- 电源A：艾诺AN50300-10，SCPI/RS485，38400 8N1，命令以CRLF结束。 -->
    <!-- 电源A不固定COM号，只按FTDI序列号自动定位并通过只读SCPI确认。 -->
    <add key="AinuoPowerAPort" value="" />
    <add key="AinuoPowerAUsbSerial" value="FTBBD8D9A" />
    <add key="AinuoPowerABaudRate" value="38400" />
    <add key="AinuoPowerAMaxVoltage" value="300" />
    <add key="AinuoPowerAMaxCurrent" value="10" />
    <add key="AinuoPowerAReadTimeoutMs" value="1500" />
    <add key="AinuoPowerAWriteTimeoutMs" value="1000" />
    <add key="AinuoPowerAOpenSettleMs" value="200" />
    <!-- 实机应答无换行符，以最后一个字节后的静默时间判定一帧结束。 -->
    <add key="AinuoPowerAResponseIdleMs" value="120" />
    <add key="AinuoPowerACommandDelayMs" value="180" />
    <add key="HengHui2Port" value="" />
    <!-- 当前测试流程不向AN50300-10电源A下发OVP，电流设定值作为正常限流值。 -->
    <add key="LoadPort" value="" />
    <add key="ElectronicLoadUsbSerial" value="FTB6D0NZA" />
    <add key="DaqPort" value="" />
    <add key="DaqUsbSerial" value="GE0120399" />
    <!-- MBD USB-B由自动识别发送单字节0D确认，不固定COM号。 -->
    <add key="TargetBoardPort" value="" />
    <!-- TTL使用CH340；该芯片没有独立序列号，只在硬件ID唯一时自动定位。 -->
    <add key="TtlPort" value="" />
    <!-- 更换为带独立序列号的USB转串口后，在此填写序列号；当前CH340按下方唯一硬件ID识别。 -->
    <add key="TtlUsbSerial" value="" />
    <add key="TtlUsbHardwareId" value="VID_1A86&amp;PID_7523" />
    <add key="SKBCM125FirmwarePath" value="" />
    <add key="SKBCM125ExpectedFirmwareVersion" value="stcu_UP125_V8" />
    <!-- BCM-125 station shunts: ST1 and ST2 use 20.5 mOhm. -->
    <add key="SKBCM125String1ShuntOhms" value="0.0205" />
    <add key="SKBCM125String2ShuntOhms" value="0.0205" />
    <add key="SKBCM250FirmwarePath" value="" />
    <!-- BCM125/BCM250使用内置STM32 UART Bootloader烧录器；无需CubeProgrammer。 -->
    <add key="SKRequireTtl" value="true" />
    <add key="SKTargetBoardBaudRate" value="9600" />
    <add key="SKMPS250TargetBoardBaudRate" value="115200" />
    <add key="SKMbdOpenSettleMs" value="500" />
    <add key="SKMbdPortReleaseWaitMs" value="300" />
    <add key="SKMbdProbeTimeoutMs" value="2000" />
    <!-- USB-B may disappear/re-enumerate after programming or DUT power cycling. -->
    <add key="SKMbdRecoveryTimeoutMs" value="15000" />
    <add key="SKMbdRecoveryRetryMs" value="750" />
    <add key="SKMbdEnumerationWaitMs" value="4000" />
    <add key="SKMbdRecoveryCommandTimeoutMs" value="2000" />
    <!-- DUT VBUS cycling can reset/re-enumerate USB-B; wait for a verified MBD terminal. -->
    <add key="SKMbdPowerCycleRecoveryTimeoutMs" value="25000" />
    <!-- 9600 baud MBD命令正常应在数百毫秒内回复；仅启动识别保留2秒探测超时。 -->
    <add key="SKMbdCommandTimeoutMs" value="700" />
    <add key="SKMbdStatefulCommandTimeoutMs" value="2000" />
    <add key="SKMbdStatefulRetryCount" value="3" />
    <add key="SKMbdStatefulRetryDelayMs" value="250" />
    <add key="SKAutoDiscoverPorts" value="true" />
    <add key="HengHuiPowerBUsbSerial" value="FTB6D146A" />
    <!-- MPS-250 power forensic telemetry; short reads avoid delaying emergency shutdown. -->
    <add key="SKMPS250PowerTelemetryEnabled" value="true" />
    <add key="SKMPS250PowerTelemetryIntervalMs" value="1000" />
    <add key="SKMPS250PowerTelemetryReadTimeoutMs" value="250" />
    <!-- B01/D01 wait for the 275 V source to reach stable measured voltage before DAQ reads. -->
    <add key="SKMPS250VbusMinimumSettleMs" value="500" />
    <add key="SKMPS250VbusStableTimeoutMs" value="5000" />
    <add key="SKMPS125VbusMinimumSettleMs" value="500" />
    <add key="SKMPS125VbusStableTimeoutMs" value="5000" />
    <!-- MPS non-PWM averages; MPS-125/MPS-250 PWM averages use at least 8 samples (16 restores the procedure count). -->
    <add key="SKMPSNonPwmAverageSampleCount" value="3" />
    <add key="SKMPS250PwmAverageSampleCount" value="8" />
    <add key="SKMPS125PwmAverageSampleCount" value="8" />
    <!-- Chapter 17: two complete passing rounds can finish the five heater waits early; XML DelayMs remains the maximum. -->
    <add key="SKMPS125HeaterEarlyMeasurementEnabled" value="true" />
    <add key="SKMPS125HeaterMinimumSettleMs" value="1000" />
    <add key="SKMPS125HeaterStableVoltageDeltaMv" value="20" />
    <add key="SKMPS125HeaterStableCurrentDeltaMa" value="2" />
    <add key="SKMPS250HeaterEarlyMeasurementEnabled" value="true" />
    <add key="SKMPS250HeaterMinimumSettleMs" value="1000" />
    <add key="SKMPS250HeaterStableVoltageDeltaMv" value="20" />
    <add key="SKMPS250HeaterStableCurrentDeltaMa" value="2" />
    <!-- All four SK sequences share completion logs; false restores start/TX/store traces. -->
    <add key="SKCompactLoggingEnabled" value="true" />
    <!-- Compatibility fallback for installations without SKCompactLoggingEnabled. -->
    <add key="SKMPSCompactLoggingEnabled" value="true" />
    <!-- MPS-250 K-series gates retain source-zero and nominal-voltage readback. -->
    <add key="SKMPS250VbattZeroToleranceV" value="0.5" />
    <add key="SKMPS250VbattZeroCurrentToleranceA" value="0.05" />
    <add key="SKMPS250VbattZeroTimeoutMs" value="30000" />
    <add key="SKMPS250VbattStableTimeoutMs" value="10000" />
    <!-- MPS-125: K01/K02 wait for zero voltage; preparation timeout warns and continues. -->
    <add key="SKMPS125VbattZeroToleranceV" value="0.5" />
    <add key="SKMPS125VbattZeroCurrentToleranceA" value="0.05" />
    <add key="SKMPS125VbattZeroTimeoutMs" value="30000" />
    <add key="SKMPS125VbattStableTimeoutMs" value="10000" />
    <add key="SKElectronicLoadBaudRate" value="38400" />
    <add key="SKElectronicLoadCommandDelayMs" value="50" />
    <add key="SKElectronicLoadReadTimeoutMs" value="2500" />
    <!-- Normal replies are ~10-20 ms. Fail fast once, resynchronize, then allow one longer recovery read. -->
    <add key="SKElectronicLoadFastQueryTimeoutMs" value="300" />
    <add key="SKElectronicLoadRecoveryQueryTimeoutMs" value="1500" />
    <add key="SKElectronicLoadWriteTimeoutMs" value="2000" />
    <add key="SKElectronicLoadQueryRetryDelayMs" value="100" />
    <add key="SKElectronicLoadQueryAttempts" value="2" />
    <!-- KL7100/7303手册未定义INP:PROT:CLE；厂家确认命令后再配置。 -->
    <add key="SKElectronicLoadProtectionClearCommand" value="" />
    <!-- 最长启动窗口仍为3秒，但从500ms开始轮询；负载通信一旦就绪立即继续。 -->
    <add key="SKElectronicLoadPowerOnDelayMs" value="3000" />
    <add key="SKElectronicLoadPowerOnInitialDelayMs" value="500" />
    <add key="SKElectronicLoadPowerOnProbeIntervalMs" value="200" />
    <add key="SKElectronicLoadPowerOnProbeTimeoutMs" value="300" />
    <!-- 每条SCPI命令已有50ms间隔；只保留短暂回读等待，失败时再重试。 -->
    <add key="SKElectronicLoadReadbackDelayMs" value="100" />
    <add key="SKElectronicLoadCvConfigureSettleMs" value="50" />
    <add key="SKElectronicLoadCvApplyAttempts" value="2" />
    <add key="SKElectronicLoadCvRetryDelayMs" value="100" />
    <!-- OFF/归零后5秒内复用已确认的安全状态；任一负载输出命令会立即使缓存失效。 -->
    <add key="SKElectronicLoadSafeZeroReuseWindowMs" value="5000" />
    <add key="SKElectronicLoadSafeZeroVerificationReuseWindowMs" value="5000" />
    <add key="SKElectronicLoadInputEnableAttempts" value="2" />
    <add key="SKElectronicLoadInputConfirmPollMs" value="100" />
    <add key="SKElectronicLoadCvReadbackToleranceV" value="15" />
    <add key="SKAnsAddress" value="1" />
    <!-- AN50300-10电源A和恒辉8602电源B各使用独立COM口及SCPI协议，不使用Modbus从站地址。 -->
    <!-- DI1-DI10原始电平按位归一化：DI4/P2直通，其余通道反相，掩码0x03F7。 -->
    <add key="SKDigitalInputInvertMask" value="1015" />
    <!-- DI8逻辑1=急停，0=正常。 -->
    <add key="SKEmergencyStopActiveHigh" value="true" />
    <add key="SKDigitalInputPort" value="" />
    <!-- 三个Modbus站号共享同一个FTDI适配器。 -->
    <add key="SKRelayBusUsbSerial" value="FTB6D43NA" />
    <add key="SKDigitalInputAddress" value="2" />
    <add key="SKDigitalInputBaudRate" value="38400" />
    <!-- SK 仪器模式单点开关：Simulation=离线模拟，Hardware=连接真实仪器。
         也可临时设置环境变量 TESTPLATFORM_SK_MODE 覆盖此值。 -->
    <add key="SKExecutionMode" value="Hardware" />
    <add key="SKBCM250FixtureOnly" value="false" />
    <!-- DataGrid仅在章节切换或到达节流间隔时滚动，测试判定仍逐项更新。 -->
    <add key="SKGridScrollIntervalMs" value="5000" />
    <!-- 条件等待命中一次即认为工作点就绪；正式测试项仍按各自采样数和XML限值判定。 -->
    <add key="SKStableSampleCount" value="1" />
    <!-- 同一批功率继电器闭合只做一次真实掉电确认；任一输出状态变化会立即使缓存失效。 -->
    <add key="SKPowerOffVerificationReuseWindowMs" value="5000" />
    <!-- 仅复用短时间内完全相同的0V/0A/OFF命令；章节边界仍由安全状态机确认。 -->
    <add key="SKVbusOffCommandReuseWindowMs" value="5000" />
    <!-- 仅在最近已验证的相同设定下省略重复设置；ON前再次查询设定值。 -->
    <add key="SKVbusSetpointReuseWindowMs" value="5000" />
    <add key="SKSecondarySetpointReuseWindowMs" value="5000" />
    <!-- R06/R14只在进入正式测量前使用较宽就绪带；最终结果仍严格采用XML限值。 -->
    <add key="SKReadinessExternalCurrentMarginMa" value="100" />
    <!-- 正式平均次数已按节拍目标下调，仍可在完成GR&amp;R后通过配置独立调整。 -->
    <add key="SKBCM250SampleCountM09" value="10" />
    <add key="SKBCM250SampleCountN01" value="8" />
    <add key="SKBCM250SampleCountN03" value="8" />
    <add key="SKBCM250SampleCountN07" value="20" />
    <add key="SKBCM250SampleCountN08" value="20" />
    <add key="SKBCM250SampleCountT01" value="20" />
    <add key="SKBCM250SampleCountT02" value="20" />
    <add key="SKAnsCurrentLimit" value="1.0" />
    <add key="SKDaqVoltageChannel" value="@101" />
    <add key="SKDaqVoltageRange" value="10.0" />
    <add key="SKDaqReadTimeoutMs" value="5000" />
    <!-- 多次平均使用DAQ内部TRIG:COUN/INIT/FETCH缓存，避免每个样本一次串口READ?。 -->
    <add key="SKDaqBufferedAverageEnabled" value="true" />
    <add key="SKDaqBufferedAverageNplc" value="1" />
    <add key="SKDaqBufferedAverageIntervalMs" value="60" />
    <!-- 固定量程避免每点自动量程；106测高压、113测小信号。 -->
    <add key="SKDaqBufferedAverageRange106" value="300" />
    <add key="SKDaqBufferedAverageRange113" value="1" />
    <add key="SKDaqBufferedAverageRange115" value="1" />
    <add key="SKDaqBufferedAverageAutoZeroOff" value="true" />
    <add key="SKDaqBufferedAverageTimeoutBaseMs" value="1000" />
    <add key="SKDaqBufferedAverageTimeoutPerSampleMs" value="400" />
    <!-- BCM125 T02/T05工程试验：固定窗口全样本平均；低谷参与平均并保留时间戳，不自动重测。 -->
    <add key="SKBCM125StringTestSampleCount" value="60" />
    <add key="SKBCM125StringTestIntervalMs" value="100" />
    <add key="SKBCM125StringTestRangeVolts" value="1" />
    <add key="SKBCM125StringTestNplc" value="1" />
    <!-- T01/T04：30点R44/200ms，与60点DAQ/100ms共用6000ms窗口；全部低值参与平均。 -->
    <add key="SKBCM125MosOnSampleCount" value="30" />
    <add key="SKBCM125MosOnIntervalMs" value="200" />
    <!-- T03/T06：关断等待后固定读取全部5点R44，200ms开始到开始；原±20mA不变，NG才追加诊断。 -->
    <add key="SKBCM125MosOffSampleCount" value="5" />
    <add key="SKBCM125MosOffIntervalMs" value="200" />
    <add key="SKRelayAddress" value="3" />
    <add key="SKRelayBaudRate" value="38400" />
    <add key="SKRelayComPort" value="" />
    <add key="SKRelayCount" value="16" />
    <add key="SKPlacementRelayA" value="@318" />
    <add key="SKPlacementRelayB" value="@319" />
    <add key="SKFixtureRelayAddress" value="1" />
    <add key="SKFixtureRelayBaudRate" value="38400" />
    <add key="SKFixtureRelayComPort" value="" />
    <!-- 工装站1下压映射；代码会按板型强制校验，防止与功率继电器站3混淆。 -->
    <add key="SKBCM125FixtureRelays" value="1,2" />
    <add key="SKBCM250FixtureRelays" value="1" />
    <add key="SKMPS125FixtureRelays" value="1" />
    <add key="SKMPS250FixtureRelays" value="1" />
    <add key="SKSafetyPollMs" value="100" />
    <add key="SKBypassFixtureDownCheck" value="false" />
    <add key="SKFixtureNoticeMinimumSeconds" value="3" />
    <add key="SKFixtureDownTimeoutMs" value="30000" />
    <!-- 高压继电器切换和治具释放前的掉电确认参数。 -->
    <add key="SKSafeOpenVoltageThreshold" value="20.0" />
    <add key="SKSafeOpenCurrentThreshold" value="0.05" />
    <add key="SKSafeDischargeTimeoutMs" value="30000" />
    <add key="SKSafeDischargePollMs" value="200" />
  </appSettings>
</configuration>
