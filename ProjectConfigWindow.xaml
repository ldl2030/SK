<Window x:Class="TestPlatform.ProjectConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TestPlatform"
        Title="项目配置" Height="820" Width="1100"
        MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        Background="#F3F6FA">
    <Window.Resources>
        <SolidColorBrush x:Key="ConfigTextBrush" Color="#172033"/>
        <SolidColorBrush x:Key="ConfigPrimaryBrush" Color="#0B5CAD"/>
        <SolidColorBrush x:Key="ConfigDangerBrush" Color="#B42318"/>
        <SolidColorBrush x:Key="ConfigBorderBrush" Color="#7B8AA0"/>

        <Style TargetType="GroupBox">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource ConfigTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ConfigBorderBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ConfigTextBrush}"/>
            <Setter Property="Background" Value="#E7F0FA"/>
            <Setter Property="BorderBrush" Value="{StaticResource ConfigPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ConfigPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ConfigPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ConfigDangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ConfigDangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ConfigDangerBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource ConfigTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ConfigBorderBrush}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource ConfigTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ConfigBorderBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="#EDF3F9"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 测试项目管理 -->
        <GroupBox Header="测试项目管理" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0">
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="选择项目：" Margin="0,0,0,5" FontWeight="Bold"/>
                        <ComboBox x:Name="cmbProjectGroups"
                                  MinWidth="180"
                                  SelectionChanged="CmbProjectGroups_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="选择机型：" Margin="0,0,0,5" FontWeight="Bold"/>
                        <ComboBox x:Name="cmbTestProjects"
                                  MinWidth="300" MaxWidth="460"
                                  DisplayMemberPath="ModelName"
                                  SelectionChanged="CmbTestProjects_SelectionChanged"/>
                    </StackPanel>
                </WrapPanel>
                <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="btnAddProject" Content="新增项目" Click="BtnAddProject_Click"/>
                    <Button x:Name="btnEditProject" Content="编辑项目" Click="BtnEditProject_Click"/>
                    <Button x:Name="btnDeleteProject" Content="删除项目"
                            Style="{StaticResource ConfigDangerButton}" Click="BtnDeleteProject_Click"/>
                </WrapPanel>
            </Grid>
        </GroupBox>

        <GroupBox x:Name="grpTestPlan" Header="运行模式" Grid.Row="1"
                  Margin="0,0,0,10" Visibility="Collapsed">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="测试 Profile：" Margin="0,0,0,5" FontWeight="Bold"/>
                    <ComboBox x:Name="cmbTestProfile"
                              SelectionChanged="CmbTestProfile_SelectionChanged"/>
                </StackPanel>
                <TextBlock x:Name="txtProfileHint" Grid.Column="1"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" Foreground="#344054"/>
            </Grid>
        </GroupBox>

        <!-- 测试项配置表格 -->
        <GroupBox Header="测试项配置" Grid.Row="2" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.RowSpan="2" Grid.Column="0"
                        Margin="5" Padding="5"
                        BorderBrush="{StaticResource ConfigBorderBrush}"
                        BorderThickness="1" CornerRadius="3"
                        Background="White">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="章节目录（勾选控制整组）"
                                   FontWeight="Bold" Margin="4,2,4,6"/>
                        <TreeView x:Name="tvTestGroups"
                                  ItemsSource="{Binding}"
                                  SelectedItemChanged="TvTestGroups_SelectedItemChanged"
                                  BorderThickness="0"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded"
                                            Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type local:TestGroupItem}"
                                                          ItemsSource="{Binding Items}">
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              IsEnabled="{Binding CanToggle}"
                                              Click="GroupEnabled_Click"
                                              Tag="{Binding}"
                                              FontWeight="SemiBold"
                                              ToolTip="{Binding GroupId}"/>
                                </HierarchicalDataTemplate>
                                <DataTemplate DataType="{x:Type local:TestItem}">
                                    <TextBlock Text="{Binding Name}"
                                               MaxWidth="225"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding StepId}"/>
                                </DataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>
                </Border>

                <!-- 测试步骤操作按钮 -->
                <WrapPanel Grid.Row="0" Grid.Column="2" Margin="5,5,5,0">
                    <Button x:Name="btnAddStep"
                    Content="新增步骤"
                    Click="BtnAddStep_Click"/>

                    <Button x:Name="btnInsertStep"
                    Content="插入步骤"
                    Click="BtnInsertStep_Click"/>

                    <Button x:Name="btnCopyStep"
                    Content="复制步骤"
                    Click="BtnCopyStep_Click"/>

                    <Button x:Name="btnDeleteStep"
                    Content="删除步骤"
                    Style="{StaticResource ConfigDangerButton}"
                    Click="BtnDeleteStep_Click"/>

                    <Button x:Name="btnMoveUp"
                    Content="上移"
                    Click="BtnMoveUp_Click"/>

                    <Button x:Name="btnMoveDown"
                    Content="下移"
                    Click="BtnMoveDown_Click"/>
                </WrapPanel>

                <DataGrid x:Name="dgTestItems"
                  Grid.Row="1"
                  Grid.Column="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  RowHeight="38"
                  RowHeaderWidth="40"
                  LoadingRow="dgTestItems_LoadingRow"
                  Margin="5">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="测试" Width="70">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="chkSelectAll"
                                      Click="ChkSelectAll_Click"
                                      HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanToggle}"
                                      Click="StepEnabled_Click"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="测试项名称"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*"
                                    MinWidth="220"/>

                        <DataGridTextColumn Header="上限"
                                    Binding="{Binding UpperLimit, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"/>

                        <DataGridTextColumn Header="下限"
                                    Binding="{Binding LowerLimit, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"/>

                        <DataGridTextColumn Header="单位"
                                    Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                    Width="80"/>

                        <DataGridTextColumn Header="执行时间(ms)"
                                    Binding="{Binding ExecTime}"
                                    IsReadOnly="True"
                                    Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnSave" Content="保存测试项" MinWidth="120"
                    Style="{StaticResource ConfigPrimaryButton}" Click="BtnSave_Click"/>
            <Button x:Name="btnCancel" Content="关闭" MinWidth="90" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
