<Window x:Class="TestPlatform.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestPlatform"
        mc:Ignorable="d"
        Title="BQC Test Platform" Height="820" Width="1280"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172033"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#40516B"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0B5CAD"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#084A8C"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#8F1C13"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#18733C"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#9A4D00"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F3F6FA"/>
        <SolidColorBrush x:Key="BorderBrushHighContrast" Color="#7B8AA0"/>

        <!-- 转换器：判断字符串是否包含关键字 -->
        <local:StringContainsConverter x:Key="StringContainsConverter"/>

        <!-- 按钮样式：圆角、悬停变色 -->
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E7F0FA"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D3E5F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#B8D4EF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#687386"/>
                                <Setter Property="BorderBrush" Value="#AAB2BF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinHeight" Value="48"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinHeight" Value="48"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- GroupBox 圆角样式 -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushHighContrast}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Background="{TemplateBinding Background}"
                                    Margin="0,10,0,0">
                                <Border BorderBrush="Transparent" 
                                        BorderThickness="1" 
                                        CornerRadius="5" 
                                        Margin="1">
                                    <ScrollViewer Margin="5">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                            <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="4" 
                                    HorizontalAlignment="Left" 
                                    Margin="10,0,0,0" 
                                    Padding="6,2">
                                <TextBlock Text="{TemplateBinding Header}" 
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid 美化 -->
        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushHighContrast}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="HeadersVisibility" Value="All"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#D7E4F2"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushHighContrast}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态指示器样式（圆形灯） -->
        <Style x:Key="StatusLight" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Fill" Value="Gray"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <!-- 工具栏按钮图标样式（字体图标） -->
        <Style x:Key="ToolButtonIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 窗口加载动画（淡入+缩放） -->
        <Storyboard x:Key="WindowFadeInZoom">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.6"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.95" To="1" Duration="0:0:0.6"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.95" To="1" Duration="0:0:0.6"/>
        </Storyboard>
    </Window.Resources>

    <!-- 外层 Grid：用于同时承载主内容和启动覆盖层 -->
    <Grid>
        <!-- 主内容 Grid（原布局，添加名称以便动画） -->
        <Grid x:Name="MainContentGrid" Margin="10" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
            </Grid.RenderTransform>

            <!-- 原有布局内容完全保留，从原 XAML 复制而来 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="110" MinHeight="80"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="560"/>
                <ColumnDefinition Width="1.25*" MinWidth="280" MaxWidth="440"/>
            </Grid.ColumnDefinitions>

            <!-- 工具栏 -->
            <ToolBarTray Grid.Row="0" Grid.ColumnSpan="2" Background="White">
                <ToolBar Band="1" BandIndex="1" Height="48" Padding="2">
                    <Label x:Name="toolStripLabel1" Content="Test System"
                           FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,12,0"
                           ToolBar.OverflowMode="Never"/>
                    <Separator/>
                    <Button x:Name="toolStripButton1" MinWidth="96" Click="toolStripButton1_Click"
                            ToolBar.OverflowMode="AsNeeded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolButtonIcon}" Foreground="#186A3B" Text="&#xE8F1;"/>
                            <TextBlock Text="登录" Foreground="#164E2D" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="toolStripButton2" MinWidth="112" Click="toolStripButton2_Click"
                            ToolBar.OverflowMode="AsNeeded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolButtonIcon}" Foreground="#0B5CAD" Text="&#xE71D;"/>
                            <TextBlock Text="项目配置" Foreground="#083F77" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="toolStripButton3" MinWidth="112" Click="toolStripButton3_Click"
                            ToolBar.OverflowMode="AsNeeded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolButtonIcon}" Foreground="#9A4D00" Text="&#xE115;"/>
                            <TextBlock Text="系统设置" Foreground="#713800" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnUtilityTools"
                            MinWidth="112"
                            Click="BtnUtilityTools_Click"
                            ToolBar.OverflowMode="AsNeeded">
                        <Button.ContextMenu>
                            <ContextMenu>
                            <MenuItem x:Name="打开设备管理器ToolStripMenuItem" Header="💻 打开设备管理器" Click="打开设备管理器ToolStripMenuItem_Click"/>
                            <MenuItem x:Name="打开默认打印机首选项ToolStripMenuItem" Header="🖨️ 打开默认打印机首选项" Click="打开默认打印机首选项ToolStripMenuItem_Click"/>
                            <MenuItem x:Name="快速截图ToolStripMenuItem" Header="📸 快速截图(Ctrl+Shift+S)" Click="快速截图ToolStripMenuItem_Click"/>
                            <MenuItem x:Name="打开计算器ToolStripMenuItem" Header="🧮 打开计算器" Click="打开计算器ToolStripMenuItem_Click"/>
                            <MenuItem x:Name="btnShowLogViewer" Header="📄 日志窗口" Click="BtnShowLogViewer_Click"/>
                            <MenuItem x:Name="btnStatistics" Header="📊 统计报告" Click="btnStatistics_Click"/>
                            <MenuItem x:Name="btnOffsetConfig" Header="✏️ 打印偏移设置" Click="btnOffsetConfig_Click"/>
                            <MenuItem x:Name="btnLEDConfig" Header="💡 LED分析仪配置" Click="btnLEDConfig_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolButtonIcon}"
                                       Text="&#xE74C;"
                                       Foreground="#0B5CAD"/>
                            <TextBlock Text="实用工具"
                                       TextWrapping="NoWrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Separator/>
                    <Button x:Name="btnCheckUpdate" MinWidth="112" Click="btnCheckUpdate_Click"
                            ToolBar.OverflowMode="AsNeeded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolButtonIcon}" Foreground="#0B5CAD" Text="&#xE72C;"/>
                            <TextBlock Text="检查更新" Foreground="#083F77" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="toolStripButton5" MinWidth="88" ToolBar.OverflowMode="AsNeeded">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ToolButtonIcon}" Foreground="#25364D" Text="&#xE946;"/>
                            <TextBlock Text="关于" Foreground="#25364D" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </ToolBar>
            </ToolBarTray>

            <!-- 进度条 -->
            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,10" Height="28">
                <ProgressBar x:Name="progressBar1" Height="28" Value="0" 
                             Foreground="#4CAF50" Background="#E0E0E0"/>
                <TextBlock x:Name="lblPercent" Text="0%" HorizontalAlignment="Center" 
                           VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" 
                           Foreground="White">
                    <TextBlock.Effect>
                        <DropShadowEffect ShadowDepth="1" BlurRadius="2" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <!-- 表格内章节折叠区 -->
            <Grid Grid.Row="2" Grid.Column="0" MinHeight="220" Margin="0,5,10,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="6" Margin="0,0,0,5"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrushHighContrast}"
                        BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="查看" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="2,0,6,0"/>
                        <ComboBox x:Name="cmbRuntimeTreeChannel" Grid.Column="1"
                                  MinHeight="28" FontWeight="SemiBold"
                                  SelectionChanged="CmbRuntimeTreeChannel_SelectionChanged"/>
                        <TextBlock Grid.Column="3" Text="快速跳转" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cmbRuntimeGroupJump" Grid.Column="4"
                                  MinHeight="28"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="CmbRuntimeGroupJump_SelectionChanged"/>
                        <TextBlock x:Name="txtRuntimeCurrentStep" Grid.Column="6"
                                   Text="当前：等待测试"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="dataGridView1" Grid.Row="1"
                          MinHeight="220"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          CanUserResizeRows="True"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          RowHeaderWidth="40"
                          LoadingRow="dataGridView1_LoadingRow"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander Tag="{Binding Name}"
                                                          IsExpanded="True"
                                                          Loaded="RuntimeGroupExpander_Loaded"
                                                          Expanded="RuntimeGroupExpander_Expanded"
                                                          Collapsed="RuntimeGroupExpander_Collapsed">
                                                    <Expander.Header>
                                                        <Border Padding="9,6" Margin="0,2"
                                                                CornerRadius="4"
                                                                BorderThickness="1"
                                                                BorderBrush="#B8C2D0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#EEF2F7"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Items[0].GroupStatus}" Value="执行中">
                                                                            <Setter Property="Background" Value="#DCEEFF"/>
                                                                            <Setter Property="BorderBrush" Value="#145C9E"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Items[0].GroupStatus}" Value="PASS">
                                                                            <Setter Property="Background" Value="#DFF6E8"/>
                                                                            <Setter Property="BorderBrush" Value="#18733C"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Items[0].GroupStatus}" Value="FAIL">
                                                                            <Setter Property="Background" Value="#FBE2DF"/>
                                                                            <Setter Property="BorderBrush" Value="#B42318"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Items[0].GroupStatus}" Value="收尾中">
                                                                            <Setter Property="Background" Value="#ECE7FA"/>
                                                                            <Setter Property="BorderBrush" Value="#5B4399"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Items[0].GroupStatus}" Value="收尾失败">
                                                                            <Setter Property="Background" Value="#F7D6D2"/>
                                                                            <Setter Property="BorderBrush" Value="#B42318"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="Bold"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Items[0].GroupSummary}"
                                                                           FontWeight="SemiBold"
                                                                           Margin="12,0,2,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </Expander.Header>
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                </DataGrid>
            </Grid>

            <!-- 右侧区域：SN输入 + 动态结果显示 -->
            <Grid Grid.Row="2" Grid.Column="1" Margin="10,5,0,5" MinWidth="260">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GroupBox Header="SN输入" Margin="5,0,5,5">
                    <TextBox x:Name="txb_snInput" TextAlignment="Center" FontSize="18" FontWeight="Bold"
                             Foreground="{StaticResource TextPrimaryBrush}" Background="White"
                             BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="2"
                             Padding="8" MinHeight="42" KeyDown="txb_snInput_KeyDown"
                             VerticalContentAlignment="Center"/>
                </GroupBox>
                <GroupBox Header="结果显示" Grid.Row="1" Margin="5">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="icResultWindows" Margin="0,5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DisplayText, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="{Binding Background}"
                                             Foreground="{Binding DisplayForeground}"
                                             FontSize="16" FontWeight="Bold" TextAlignment="Center"
                                             TextWrapping="Wrap" IsReadOnly="True"
                                             MinHeight="88" Padding="8" Margin="0,5"
                                             BorderBrush="{StaticResource BorderBrushHighContrast}" BorderThickness="2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>
                <TextBox x:Name="txb_testTime" Grid.Row="2" TextAlignment="Center" IsReadOnly="True"
                         FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                         Height="38" Margin="5" Background="{StaticResource SurfaceMutedBrush}"
                         BorderBrush="{StaticResource BorderBrushHighContrast}"/>
                <Grid Grid.Row="3" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btn_statsTest" Grid.Column="0" Content="开始测试 (Space)"
                            Style="{StaticResource PrimaryActionButton}" Margin="5"
                            Click="btn_statsTest_Click"/>
                    <Button x:Name="button2" Grid.Column="1" Content="停止测试 (Esc)"
                            Style="{StaticResource DangerActionButton}" Margin="5"
                            Click="button2_Click"/>
                </Grid>
            </Grid>

            <!-- Activity Loading -->
            <GroupBox Header="Activity Loading" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,5,0,5">
                <RichTextBox x:Name="rictxB_log" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Microsoft YaHei UI" FontSize="13"
                             Background="#FFFFFF" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrushHighContrast}" BorderThickness="1"/>
            </GroupBox>

            <!-- 工单/工站信息栏 -->
            <Border Grid.Row="4" Grid.ColumnSpan="2" Margin="0,5,0,5" Padding="10,5" 
                    Background="#F0F0F0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="当前工单：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtCurrentWorkOrder" Text="未设置" VerticalAlignment="Center" Margin="5,0,20,0"
                               FontWeight="Bold" Foreground="#083F77"/>
                    <TextBlock Text="当前工站：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtCurrentWorkStation" Text="未设置" VerticalAlignment="Center" Margin="5,0,0,0"
                               FontWeight="Bold" Foreground="#083F77"/>
                </WrapPanel>
            </Border>

            <!-- 状态栏 -->
            <Border Grid.Row="5" Grid.ColumnSpan="2" Margin="0,5,0,0" Padding="10,5" 
                    Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <WrapPanel HorizontalAlignment="Center">
                    <!-- MES 状态 -->
                    <StackPanel Orientation="Horizontal" Margin="20,0">
                        <Ellipse Style="{StaticResource StatusLight}" Fill="#4CAF50" x:Name="mesStatusLight"/>
                        <TextBlock Text="MES状态" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock x:Name="mesStatusText" Text="已连接" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#4CAF50"/>
                    </StackPanel>
                    <!-- FTP 状态 -->
                    <StackPanel Orientation="Horizontal" Margin="20,0">
                        <Ellipse Style="{StaticResource StatusLight}" Fill="#4CAF50" x:Name="ftpStatusLight"/>
                        <TextBlock Text="FTP状态" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock x:Name="ftpStatusText" Text="已连接" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#4CAF50"/>
                    </StackPanel>
                    <!-- SMB 状态 -->
                    <StackPanel Orientation="Horizontal" Margin="20,0">
                        <Ellipse Style="{StaticResource StatusLight}" Fill="#4CAF50" x:Name="smbStatusLight"/>
                        <TextBlock Text="SMB状态" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock x:Name="smbStatusText" Text="已关闭" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#4CAF50"/>
                    </StackPanel>
                    <!-- 登录状态 -->
                    <StackPanel Orientation="Horizontal" Margin="20,0">
                        <Ellipse Style="{StaticResource StatusLight}" Fill="#FF9800" x:Name="loginStatusLight"/>
                        <TextBlock Text="登录状态" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock x:Name="loginStatusText" Text="未登录" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="#FF9800"/>
                    </StackPanel>
                    <!-- 剩余测试次数 -->
                    <TextBlock x:Name="txtRemainingTests" Text="剩余测试次数: 无限制"
                               Margin="20,2,0,2" VerticalAlignment="Center"
                               FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </WrapPanel>
            </Border>
        </Grid>

        <!-- 启动覆盖层：显示真实加载进度（独立于主内容，覆盖整个窗口） -->
        <Border x:Name="SplashOverlay" Background="White" Visibility="Visible" Opacity="1"
                Panel.ZIndex="1000">
            <Grid>
                <Rectangle Fill="#F8F8F8" Opacity="0.98"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 旋转齿轮图案 -->
                    <Grid Margin="0,0,0,30" Width="80" Height="80" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Width="80" Height="80" Stroke="#4CAF50" StrokeThickness="4"
                                 StrokeDashArray="5 2" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:2" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="⚙" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#4CAF50"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </Grid>

                    <TextBlock x:Name="SplashText" Text="正在加载配置..." FontSize="16" FontWeight="SemiBold"
                               Foreground="#555" Margin="0,0,0,20"/>
                    <ProgressBar x:Name="SplashProgressBar" Width="300" Height="6" Minimum="0" Maximum="100"
                                 Value="0" Foreground="#4CAF50" Background="#E0E0E0" Margin="0,0,0,10"/>
                    <TextBlock x:Name="SplashPercent" Text="0%" FontSize="14" Foreground="#666"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
