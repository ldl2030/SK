<Window x:Class="TestPlatform.ProjectEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="项目配置"
        Height="520"
        Width="620"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="基础配置" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="项目完整名称：" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                 x:Name="txtDisplayName"
                                 Margin="5"
                                 LostFocus="TxtDisplayName_LostFocus"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="项目分类：" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                 x:Name="txtGroupName"
                                 Margin="5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="机型名称：" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                 x:Name="txtModelName"
                                 Margin="5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="XML文件路径：" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 x:Name="txtFilePath"
                                 Margin="5"
                                 ToolTip="新建项目时可留空，确定后会自动生成 XML。也可以手动输入或点击右侧按钮选择/新建 XML 路径。"/>
                        <Button Grid.Row="3" Grid.Column="2"
                                Content="选择/新建"
                                Width="80"
                                Margin="5"
                                Click="BtnBrowse_Click"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="更新URL：" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                 x:Name="txtUpdateUrl"
                                 Margin="5"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="运行配置" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Runner：" VerticalAlignment="Center" Margin="0,5"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  x:Name="cmbRunner"
                                  Margin="5"
                                  IsEditable="True">
                            <ComboBoxItem Content="Legacy"/>
                            <ComboBoxItem Content="XmlRunner"/>
                            <ComboBoxItem Content="TemplateRunner"/>
                            <ComboBoxItem Content="PluginRunner"/>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="SequenceKey：" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 x:Name="txtSequenceKey"
                                 Margin="5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="ComInitKey：" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="2" Grid.Column="1"
                                 x:Name="txtComInitKey"
                                 Margin="5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="FTP路径：" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 x:Name="txtFtpBasePath"
                                 Margin="5"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="必需串口：" VerticalAlignment="Top" Margin="0,8,0,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1"
                                 x:Name="txtRequiredComPorts"
                                 Margin="5"
                                 Height="80"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="每行一个串口变量名，例如 rs485ComName"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="80" Margin="5" Click="BtnOK_Click"/>
            <Button Content="取消" Width="80" Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>